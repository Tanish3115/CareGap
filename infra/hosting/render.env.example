# Enter only into Render's backend environment. Never NEXT_PUBLIC_* or Git.
ENVIRONMENT=production
DEMO_MODE=false
COOKIE_SECURE=true
SECRET_KEY=
# Supabase direct or SESSION pooler connection, not transaction pooling.
DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
CORS_ORIGINS=["https://YOUR_FRONTEND.vercel.app"]
RATE_LIMIT_STORAGE_URI=rediss://default:URL_ENCODED_PASSWORD@YOUR_REDIS_HOST:6379
STORAGE_BACKEND=s3
S3_PROVIDER=supabase
S3_ENDPOINT_URL=https://PROJECT_REF.storage.supabase.co/storage/v1/s3
S3_REGION=YOUR_PROJECT_REGION
S3_BUCKET=caregap-private
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SERVER_SIDE_ENCRYPTION=
# Keep false until the project's managed encryption/private bucket review is recorded.
S3_MANAGED_ENCRYPTION_VERIFIED=false
S3_ENCRYPTION_REVIEW_REFERENCE=
SUMMARY_PROVIDER=extractive
SUMMARY_PROVIDER_APPROVED=false
TERMINOLOGY_MODE=disabled
KNOWLEDGE_MODE=disabled
OCR_ENABLED=true
PORT=10000
