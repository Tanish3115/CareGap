SECRET_KEY=CHANGE_ME_generate_at_least_32_random_bytes
DATABASE_URL=sqlite:///./caregap360.db
ENVIRONMENT=development
COOKIE_SECURE=false
RATE_LIMIT_STORAGE_URI=memory://
LOCAL_VOLUME_ENCRYPTION_VERIFIED=false
S3_SERVER_SIDE_ENCRYPTION=
S3_KMS_KEY_ID=
STORAGE_DIR=./storage/documents
STORAGE_BACKEND=local
S3_ENDPOINT_URL=http://127.0.0.1:59000
S3_BUCKET=caregap-private
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
OCR_ENABLED=true
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
### Summary assistance: local extracts by default; external mode requires named patient consent.
SUMMARY_PROVIDER=extractive
SUMMARY_PROVIDER_URL=
SUMMARY_PROVIDER_TOKEN=
SUMMARY_PROVIDER_REFERENCE=local-source-extracts-v1
SUMMARY_PROVIDER_APPROVED=false
# Offline exact-alias terminology. Synthetic mode has no real medication vocabulary.
TERMINOLOGY_MODE=disabled
TERMINOLOGY_CATALOG_PATH=
TERMINOLOGY_CATALOG_SHA256=
TERMINOLOGY_CATALOG_APPROVED=false
TERMINOLOGY_APPROVAL_REFERENCE=

# Optional licensed offline evidence; must match the approved terminology catalog.
KNOWLEDGE_MODE=disabled
KNOWLEDGE_CATALOG_PATH=
KNOWLEDGE_CATALOG_SHA256=
KNOWLEDGE_CATALOG_APPROVED=false
KNOWLEDGE_APPROVAL_REFERENCE=
