# Copy to root .env for Docker. Generate random URL-safe secrets.
SECRET_KEY=CHANGE_ME_generate_at_least_32_random_bytes
POSTGRES_PASSWORD=CHANGE_ME_generate_a_random_url_safe_password
POSTGRES_PORT=55432
FRONTEND_PORT=3300
BACKEND_PORT=8001
STORAGE_BACKEND=local
# Optional locally built MinIO: docker compose --profile object-storage up -d minio
MINIO_ROOT_USER=CHANGE_ME_generate_a_random_user
MINIO_ROOT_PASSWORD=CHANGE_ME_generate_a_random_password
MINIO_PORT=59000
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET=caregap-private
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
OCR_ENABLED=true
# Development uses in-memory throttling; production requires a rediss:// shared store.
RATE_LIMIT_STORAGE_URI=memory://
COOKIE_SECURE=false
LOCAL_VOLUME_ENCRYPTION_VERIFIED=false
# Optional new-object encryption: AES256 or aws:kms, with an explicit KMS key identifier.
S3_SERVER_SIDE_ENCRYPTION=
S3_KMS_KEY_ID=
### Summary assistance: local extracts by default. Never put secrets in this example.
SUMMARY_PROVIDER=extractive
SUMMARY_PROVIDER_URL=
SUMMARY_PROVIDER_TOKEN=
SUMMARY_PROVIDER_REFERENCE=local-source-extracts-v1
SUMMARY_PROVIDER_APPROVED=false
# Offline terminology only; mount an approved catalog read-only when selecting approved_catalog.
TERMINOLOGY_MODE=disabled
TERMINOLOGY_CATALOG_PATH=
TERMINOLOGY_CATALOG_SHA256=
TERMINOLOGY_CATALOG_APPROVED=false
TERMINOLOGY_APPROVAL_REFERENCE=

# Optional licensed offline evidence; must match the approved terminology catalog.
KNOWLEDGE_MODE=disabled
KNOWLEDGE_CATALOG_PATH=
KNOWLEDGE_CATALOG_SHA256=
KNOWLEDGE_CATALOG_APPROVED=false
KNOWLEDGE_APPROVAL_REFERENCE=
