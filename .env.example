# Backend Configuration
PROJECT_NAME="CareGap 360"
VERSION="0.1.0"
API_V1_PREFIX="/api/v1"

# Security (Generate a strong 256-bit random key in production)
SECRET_KEY="dev-insecure-secret-key-change-in-production-caregap360-super-secret"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (Default: SQLite for local execution; PostgreSQL for Docker/Production)
DATABASE_URL="sqlite:///./caregap360.db"
# DATABASE_URL="postgresql://caregap_user:caregap_password@localhost:5432/caregap360_db"

# Document Vault Storage
STORAGE_DIR="./storage/documents"
MAX_FILE_SIZE_BYTES=26214400

# CORS
CORS_ORIGINS='["http://localhost:3000","http://127.0.0.1:3000"]'

# Frontend Configuration
NEXT_PUBLIC_API_URL="http://127.0.0.1:8000/api/v1"

