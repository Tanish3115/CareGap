{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "files": { "includes": ["src/**"] },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 110 },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "useExhaustiveDependencies": {
          "level": "error",
          "options": { "reportUnnecessaryDependencies": false }
        }
      },
      "style": { "noNonNullAssertion": "off" },
      "suspicious": {
        "noArrayIndexKey": "off",
        "noUnknownAtRules": { "level": "error", "options": { "ignore": ["tailwind"] } }
      }
    }
  }
}
